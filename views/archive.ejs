<%- include('partials/head', { pageTitle: "Archive", pageDescription: "Browse past posts through time." }) %>
<%- include('partials/navbar') %>

<main id="main" class="archive-page">
  <div class="archive-bg" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <radialGradient id="ag-glow" cx="50%" cy="38%" r="60%">
          <stop offset="0%" stop-color="rgba(133,15,25,0.06)" />
          <stop offset="100%" stop-color="rgba(133,15,25,0)" />
        </radialGradient>
      </defs>
      <rect width="1440" height="900" fill="#FAF9F8" />
      <rect width="1440" height="900" fill="url(#ag-glow)" />
      <path d="M0 720 C 360 640, 1080 640, 1440 720 L1440 900 L0 900 Z" fill="rgba(133,15,25,0.03)" />
      <path d="M0 780 C 480 720, 960 720, 1440 780 L1440 900 L0 900 Z" fill="rgba(133,15,25,0.02)" />
    </svg>
  </div>

  <div class="container archive-container">
    <section class="archive-toolbar">
      <div class="archive-search" role="search">
        <svg class="archive-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input class="archive-search-input" id="archive-search" type="search" placeholder="Search posts in the archive..." autocomplete="off" aria-label="Search posts in the archive" />
        <kbd class="archive-kbd" id="archive-kbd" aria-hidden="true">Ctrl&nbsp;K</kbd>
      </div>

      <div class="archive-filters" id="archive-filters" role="group" aria-label="Filter posts by tag"></div>
    </section>

    <section class="archive-hero">
      <div class="archive-timeline" id="archive-timeline">
        <svg class="archive-svg" viewBox="0 0 560 560" id="archive-svg" tabindex="0" role="img" aria-label="Archive timeline. Use arrow keys to move between posts.">
          <circle class="archive-ring-glow" cx="280" cy="280" r="262" />
          <circle class="archive-ring" cx="280" cy="280" r="250" />
          <circle class="archive-ring-dashed" cx="280" cy="280" r="176" />
          <circle class="archive-arc" id="archive-arc" cx="280" cy="280" r="250" />
          <g id="archive-nodes"></g>
          <g id="archive-labels"></g>
        </svg>
        <div class="archive-timeline-center" aria-hidden="true">
          <span class="archive-eyebrow">Archive</span>
          <h2 class="archive-glossary">Glossary</h2>
          <p class="archive-glossary-sub">Browse past posts through time</p>
          <span class="archive-rule"></span>
        </div>
        <div class="archive-tooltip" id="archive-tooltip" role="status" aria-live="polite"></div>
      </div>

      <article class="archive-preview" id="archive-preview" aria-live="polite"></article>
    </section>

    <section class="archive-all">
      <div class="archive-all-head">
        <h2 class="archive-all-title">All Posts</h2>
        <div class="archive-all-right">
          <span class="archive-count" id="archive-count">0 posts</span>
          <label class="archive-sort">
            <span class="visually-hidden">Sort posts</span>
            <select id="archive-sort" aria-label="Sort posts">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="az">Title A&ndash;Z</option>
            </select>
          </label>
        </div>
      </div>
      <div class="archive-grid" id="archive-grid"></div>
      <p class="archive-empty" id="archive-empty" hidden>No posts match your search.</p>
    </section>
  </div>
</main>

<script>window.__POSTS__ = <%- JSON.stringify(archiveData).replace(/</g, "\\u003c") %>;</script>
<script>window.__BASE__ = <%- JSON.stringify(base || "") %>;</script>
<script src="<%= asset('/js/archive.js') %>"></script>

<%- include('partials/footer') %>
