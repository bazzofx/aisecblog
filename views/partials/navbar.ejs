<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container navbar">
    <a class="brand" href="<%= url('/') %>">
      <% if (site.logo) { %><img class="brand-logo" src="<%= asset(site.logo) %>" alt="" /><% } %>
      <span><%= site.name %></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <% site.nav.forEach(function (item) { %>
        <% var current = path === item.href || (item.href === "/tags" && path.indexOf("/tags") === 0); %>
        <a class="nav-link" href="<%= url(item.href) %>"<% if (current) { %> aria-current="page"<% } %>><%= item.label %></a>
      <% }) %>
    </nav>

    <div class="nav-actions">
      <% if (site.githubUrl) { %>
        <a class="nav-icon-link" href="<%= site.githubUrl %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
          <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      <% } %>
      <% if (site.subscribe) { %>
        <a class="btn btn-primary" href="#subscribe">Subscribe</a>
      <% } %>
    </div>

    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
      <svg class="icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14"/></svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15"/></svg>
      <span>Menu</span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-nav-panel>
    <div class="container">
      <% site.nav.forEach(function (item) { %>
        <% var current = path === item.href || (item.href === "/tags" && path.indexOf("/tags") === 0); %>
        <a class="nav-link" href="<%= url(item.href) %>"<% if (current) { %> aria-current="page"<% } %>><%= item.label %></a>
      <% }) %>
      <div class="nav-actions">
        <% if (site.githubUrl) { %>
          <a class="nav-icon-link" href="<%= site.githubUrl %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
            <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        <% } %>
        <% if (site.subscribe) { %>
          <a class="btn btn-primary" href="#subscribe">Subscribe</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
