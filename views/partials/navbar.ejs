<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container navbar">
    <a class="brand" href="/">
      <% if (site.logo) { %><img class="brand-logo" src="<%= site.logo %>" alt="" /><% } %>
      <span><%= site.name %></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <% site.nav.forEach(function (item) { %>
        <% var current = path === item.href || (item.href === "/tags" && path.indexOf("/tags") === 0); %>
        <a class="nav-link" href="<%= item.href %>"<% if (current) { %> aria-current="page"<% } %>><%= item.label %></a>
      <% }) %>
    </nav>

    <div class="nav-actions">
      <% if (site.subscribe) { %>
        <a class="btn btn-primary" href="#subscribe">Subscribe</a>
      <% } %>
    </div>

    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
      <svg class="icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14"/></svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15"/></svg>
      <span>Menu</span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-nav-panel>
    <div class="container">
      <% site.nav.forEach(function (item) { %>
        <% var current = path === item.href || (item.href === "/tags" && path.indexOf("/tags") === 0); %>
        <a class="nav-link" href="<%= item.href %>"<% if (current) { %> aria-current="page"<% } %>><%= item.label %></a>
      <% }) %>
      <% if (site.subscribe) { %>
        <div class="nav-actions"><a class="btn btn-primary" href="#subscribe">Subscribe</a></div>
      <% } %>
    </div>
  </div>
</header>
