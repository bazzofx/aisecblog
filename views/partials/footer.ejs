<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand" href="<%= url('/') %>">
        <% if (site.logo) { %><img class="brand-logo" src="<%= asset(site.logo) %>" alt="" /><% } %>
        <span><%= site.name %></span>
      </a>
      <p><%= site.footer.text %></p>

      <% if (site.subscribe) { %>
        <form class="subscribe" style="margin-inline: 0; margin-top: 1.25rem;" id="subscribe" data-subscribe-form data-subscribe-endpoint="<%= site.subscribeEndpoint %>" action="<%= site.subscribeEndpoint || "#" %>" method="post">
          <input class="subscribe-input" type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </form>
        <p class="subscribe-note" data-subscribe-note>Get the latest posts in your inbox. No spam, ever.</p>
      <% } %>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <% site.nav.forEach(function (item) { %>
        <a href="<%= url(item.href) %>"><%= item.label %></a>
      <% }) %>
      <% if (site.githubUrl) { %>
        <a href="<%= site.githubUrl %>" target="_blank" rel="noopener noreferrer">GitHub</a>
      <% } %>
    </nav>
  </div>

  <div class="container footer-bottom">
    &copy; <%= new Date().getFullYear() %> <%= site.name %>. Built with Node.js + Express.
  </div>
</footer>
<script src="<%= asset('/js/main.js') %>"></script>
</body>
</html>
